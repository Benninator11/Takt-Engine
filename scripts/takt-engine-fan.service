[Unit]
Description=Takt Engine persistent Raspberry Pi fan curve
After=local-fs.target
ConditionPathExists=/opt/takt-engine/src/takt_engine/core/fan_curve.py

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/takt-engine-fan-control.py
Restart=always
RestartSec=3
TimeoutStopSec=5
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/sys/class/hwmon /run/takt-engine /etc/takt-engine /var/lib/takt-engine

[Install]
WantedBy=multi-user.target
